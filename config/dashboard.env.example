# /etc/linux-dashboard/dashboard.env -- Einstellungen des Dashboard-Containers.
# Gehoert DIR: install.sh --update aendert keine Werte, haengt nur neue
# Schluessel an. Wirksam nach:  docker compose up -d   (bzw. install.sh --update)
# Format: KEY=wert, KEINE Anfuehrungszeichen, KEINE Kommentare hinter Werten.

# Port des Dashboards (lauscht auf allen Interfaces, network_mode host)
DASH_PORT=8420

# Wer darf direkt zugreifen? Immer erlaubt: localhost + Docker-Bridges.
# Ohne Tunnel/Reverse-Proxy hier die eigenen Netze eintragen, Komma-getrennt,
# CIDR oder IP-Praefix. "*" = jeder (nur hinter einer Firewall!).
#   Beispiel LAN + Tailscale:  192.168.0.0/16,100.64.0.0/10,fd7a:115c:a1e0::/48
DASHBOARD_ALLOWED_NETS=

# Von welchen Gegenstellen werden Proxy-Header (X-Real-IP, X-Forwarded-For,
# CF-Connecting-IP) geglaubt? Leer = loopback + alle privaten Netze (passt NUR,
# wenn ausschliesslich ein Tunnel/Proxy zugreift). Bei direktem LAN-Zugriff
# auf loopback beschraenken, sonst kann ein LAN-Client fremde IPs sperren lassen.
DASHBOARD_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Optional: Adresse, auf die die Sperrseite verweist (z. B. https://dash.example.com)
DASHBOARD_PUBLIC_URL=

# Superadmins (volle Rechte), Komma-getrennt. Weitere Admins: Gruppe DASH_ADMIN_GROUP.
DASH_SUPERADMINS=root
DASH_ADMIN_GROUP=dashadmin

# Internet-Interface fuer die IDS-Kachel (auto = Standardroute)
DASHBOARD_WAN_IF=auto

# Oeffentliche IPv4-Adressen des Hosts (Gast-Link-Isolation fuer VMs).
# Leer = automatisch erkennen.
DASH_HOST_PUBLIC_IPS=

# Secure-Flag der Cookies: auto = nur wenn per HTTPS/Proxy (Proxy-Header) zugegriffen
# wird; 1 = immer (nur HTTPS), 0 = nie. Bei reinem HTTP-Zugriff muss es "auto" oder 0 sein.
DASHBOARD_COOKIE_SECURE=auto
